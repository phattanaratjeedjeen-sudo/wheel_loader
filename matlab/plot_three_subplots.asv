theta_g = out.ScopeData.signals(1).values;
a = out.ScopeData.signals(2).values;
w = out.ScopeData.signals(3).values;
t = out.tout;

figure(1);
sgtitle('non-mass structure');
lw = 2.5; % desired line width
set(groot,'defaultLineLineWidth',lw); % apply to all subsequent plots

% 
subplot(3,1,1);
plot(t, theta_g);
xlabel('Time (s)');
xlim("tight")
ylabel('\theta_g');
ylim([-45;45])
title('\theta_g vs Time');
grid on;

subplot(3,1,2);
plot(t, a);
xlabel('Time (s)');
xlim("tight")
ylabel('a');
title('a vs Time');
grid on;

subplot(3,1,3);
plot(t, w);
xlabel('Time (s)');
xlim("tight")
ylabel('w');
title('w vs Time');
grid on;